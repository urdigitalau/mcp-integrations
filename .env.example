# WordPress (packages/wordpress)
# Create an Application Password under wp-admin -> Users -> Profile -> Application Passwords
WORDPRESS_SITE_URL=https://example.com
WORDPRESS_USERNAME=your-wp-username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Bing Webmaster Tools (packages/bing-webmaster)
# Generate under bing.com/webmasters -> Settings -> API Access
BING_WEBMASTER_API_KEY=your-bing-api-key

# Microsoft Clarity (packages/clarity)
# Generate under Clarity project -> Settings -> Data Export -> Generate new API token
# Note: tokens are scoped to a single project.
CLARITY_API_TOKEN=your-clarity-project-token
