{
  "name": "@urdigital/mcp-server-xero",
  "version": "0.2.0",
  "description": "MCP server for Xero: 41 tools across Accounting, Reports, Payments, Manual Journals, Budgets, Attachments, Payroll AU, Files, Assets, and Projects. Full OAuth 2.0 (not Custom Connections) — see this package's README for the required one-time setup step.",
  "type": "module",
  "bin": {
    "mcp-server-xero": "dist/index.js"
  },
  "files": ["dist"],
  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "xero", "accounting", "invoicing", "claude"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urdigitalau/mcp-integrations.git",
    "directory": "packages/xero"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/setup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@urdigital/mcp-server-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "zod": "^3.25.0"
  }
}
