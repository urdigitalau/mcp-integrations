{
  "name": "@urdigital/mcp-server-abs",
  "version": "0.1.0",
  "description": "MCP server for the Australian Bureau of Statistics Data API: discover and query 1200+ official Australian statistical datasets (economic, social, Census) via SDMX.",
  "type": "module",
  "bin": {
    "mcp-server-abs": "dist/index.js"
  },
  "files": ["dist"],
  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "abs", "australian-bureau-of-statistics", "sdmx", "statistics", "claude"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urdigitalau/mcp-integrations.git",
    "directory": "packages/abs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@urdigital/mcp-server-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "zod": "^3.25.0"
  }
}
